{
  "appId": "com.gokerala.gesturerun",
  "appName": "GoKeralam",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#04120a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
